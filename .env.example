# Google Gemini Pro API Key (Google AI Studio)
# Route Handlers will access this key securely on the server side
GEMINI_API_KEY=your_gemini_api_key_here

# USD to GTQ Exchange Rate (default: 7.85)
# 1 USD = 7.85 GTQ
USD_GTQ_EXCHANGE_RATE=7.85

# Unclassified Expenses Threshold (default: 10)
# If unclassified transactions count > threshold, LLM classification is triggered
UNCLASSIFIED_EXPENSES_THRESHOLD=10
